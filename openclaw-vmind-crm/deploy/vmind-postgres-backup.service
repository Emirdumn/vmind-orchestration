[Unit]
Description=VMind PostgreSQL local custom-format backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=openclaw
Group=openclaw
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=vmind
Environment=PGUSER=openclaw
ExecStart=/home/openclaw/.openclaw/extensions/vmind-crm/deploy/vmind-postgres-backup
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/openclaw/.openclaw/backups/postgres
