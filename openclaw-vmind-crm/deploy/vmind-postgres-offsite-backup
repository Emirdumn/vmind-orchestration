#!/usr/bin/env bash
set -euo pipefail

: "${RESTIC_REPOSITORY:?RESTIC_REPOSITORY gerekli}"
: "${RESTIC_PASSWORD_FILE:?RESTIC_PASSWORD_FILE gerekli}"
backup_dir=${VMIND_BACKUP_DIR:-/home/openclaw/.openclaw/backups/postgres}
tag=${VMIND_BACKUP_TAG:-vmind-crm}
shopt -s nullglob
backups=("$backup_dir"/vmind-*.dump)
(( ${#backups[@]} > 0 )) || { echo 'offsite için yerel CRM dump yok' >&2; exit 1; }
latest=${backups[-1]}
checksum="$latest.sha256"
[[ -r "$checksum" ]] || { echo 'offsite için CRM checksum yok' >&2; exit 1; }
(cd "$backup_dir" && sha256sum -c "$(basename "$checksum")")

exec 9>/run/lock/vmind-crm-postgres-offsite.lock
flock -n 9 || { echo 'CRM offsite backup zaten çalışıyor' >&2; exit 0; }
restic backup "$latest" "$checksum" --tag "$tag" --host "$(hostname -f)"
restic forget --tag "$tag" --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --prune
restic check
