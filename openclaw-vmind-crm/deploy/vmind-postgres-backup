#!/usr/bin/env bash
set -euo pipefail

backup_dir=/home/openclaw/.openclaw/backups/postgres
stamp=$(date -u +%Y%m%dT%H%M%SZ)
target="$backup_dir/vmind-$stamp.dump"

install -d -m 700 "$backup_dir"
pg_dump --format=custom --compress=9 --file="$target" vmind
chmod 600 "$target"
pg_restore --list "$target" >/dev/null
find "$backup_dir" -maxdepth 1 -type f -name 'vmind-*.dump' -mtime +14 -delete
