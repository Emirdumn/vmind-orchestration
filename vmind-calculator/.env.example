# VMind Teklif Ajani — ortam degiskenleri
#
# HICBIRI ZORUNLU DEGIL. Bos birakilirsa istemci, uretim bundle'inda herkese acik
# olarak servis edilen degerleri kullanir (bkz. docs/auth.md).

# API taban adresi. Bundle'daki appConfig.wsUrl + "/api/v1"
VMIND_API_BASE_URL=https://tr-ist-01-api.portvmind.com/api/v1

# Authorization: Bearer <bu deger>
# Varsayilan, calculator.portvmind.com bundle'inda gomulu olan public anahtardir.
# VMind ayri bir servis hesabi/anahtari verirse burasi degistirilir.
VMIND_API_KEY=

# X-Lang basligi: tr | en
VMIND_LANG=tr


# ===========================================================================
# LLM SAGLAYICI — yukaridaki VMind anahtarindan TAMAMEN AYRI bir seydir.
#
#   VMind anahtari  -> katalog, fiyat, teklif kaydetme
#   LLM anahtari    -> satisci cumlesini anlayan model (Extractor / Designer)
#
# Asagidakilerden BIRI yeterli. Ikisi de tanimliysa OpenRouter oncelikli.
# Hicbiri yoksa deterministik katmanlar yine calisir; yalnizca `npm run eval`
# ve dogal dil girdisi devre disi kalir.
# ===========================================================================

# Yerel gelistirmede ortam degiskeni yoksa uygulama otomatik olarak repo
# kokundeki veya bir ust dizindeki gitignore'lu `key.key` dosyasina bakar.
# Baska bir konum icin tam dosya yolunu burada belirtebilirsiniz.
LLM_KEY_FILE=

# --- Secenek 1: OpenRouter (openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Varsayilan: anthropic/claude-opus-5 (birinci taraf ile ayni fiyat: $5/$25 per MTok)
# Daha ucuz alternatif: anthropic/claude-sonnet-5 ($2/$10)
OPENROUTER_MODEL=anthropic/claude-opus-5
# Bos birakilan katman mevcut OPENROUTER_MODEL degerine geri doner. OpenRouter
# hesabinizda erisilebilir model slug'larini burada ayri ayri belirleyin.
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_BALANCED=
OPENROUTER_MODEL_STRONG=
OPENROUTER_REASONING=minimal

# --- Secenek 2: Anthropic dogrudan (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_BALANCED=
ANTHROPIC_MODEL_STRONG=

# Model basina en fazla cikti token'i. OpenRouter max_tokens'i ON YETKILENDIRME
# olarak kesiyor: kredin bu kadarini karsilamiyorsa istek HTTP 402 doner.
OPENROUTER_MAX_TOKENS=8000


# ===========================================================================
# WEB ARAYUZU (npm run web / docker compose)
# ===========================================================================

# Sunucunun dinledigi adres. Konteynerde 0.0.0.0 OLMAK ZORUNDA; yereldeyken
# 127.0.0.1 birakin ki yanlislikla aga acilmasin.
HOST=127.0.0.1
PORT=8080

# --- kimlik dogrulama ---
# vmind-token   : satisci VMind konsol token'ini bir kez yapistirir, sunucu
#                 platforma sorarak DOGRULAR. Kimligin kaynagi VMind. (varsayilan)
# public-guest  : musteri sifre gormez. Ayrı HttpOnly ziyaretçi oturumu,
#                 IP-hash limit ve Turnstile ile public site modu.
# shared-secret : tek ortak sifre. GERCEK kimlik dogrulamasi degildir; yalnizca
#                 yerel gelistirme icin ve WEB_ALLOW_WEAK_AUTH=1 gerektirir.
# disabled      : giris ekranini tamamen kaldirir; yalnizca yerel gelistirme
#                 icin ve WEB_ALLOW_WEAK_AUTH=1 ile calisir.
WEB_AUTH_MODE=vmind-token
WEB_SHARED_PASSWORD=
WEB_ALLOW_WEAK_AUTH=

# --- Yönetim API'si ve /admin ekranı ---
# Müşteri/site oturumundan bağımsız, en az 32 karakterlik rastgele Bearer
# anahtarıdır. Boşsa bütün /api/admin uçları ve yönetim verisi kapalıdır.
# Anahtar tarayıcıda kalıcı depoya yazılmaz; /admin ekranında sekme belleğindedir.
WEB_ADMIN_API_KEY=

# Yalnız public-guest modu. En az 32 karakterlik rastgele HMAC sırrı; ham IP
# PostgreSQL'e veya loga yazılmaz. Bu sır değişirse yalnız bellek sayaçlarının
# hash anahtarı değişir.
WEB_PUBLIC_IP_HASH_SECRET=
WEB_PUBLIC_REQUESTS_PER_MINUTE=120
WEB_PUBLIC_FLOWS_PER_HOUR=5

# X-Forwarded-For yalnız uygulama güvenilir bir ters vekilin arkasındaysa açılır.
WEB_TRUST_PROXY=0

# Telefon/CRM onayının bağlandığı değişmez bildirim sürümü.
WEB_PRIVACY_NOTICE_VERSION=2026-08-14

# Public üretimde ikisi de zorunlu. Secret yalnız sunucuda kalır.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=teklif.example.com

# Yalnız yerel test için; üretimde kullanmayın.
WEB_PUBLIC_ALLOW_NO_TURNSTILE=0

# --- OpenClaw / vGPT servis hesabi ---
# En az 32 karakterlik, yalnizca bu entegrasyona ait iptal edilebilir anahtar.
# Istekler: Authorization: Bearer <WEB_SERVICE_API_KEY>
# Anahtari WhatsApp mesajina veya SKILL.md'ye yazmayin; OpenClaw secret/env
# ayarina VMIND_CALCULATOR_API_KEY olarak ekleyin.
WEB_SERVICE_API_KEY=
WEB_SERVICE_ID=openclaw
WEB_SERVICE_NAME=OpenClaw WhatsApp

# Varsayilan KAPALI. 1 olursa OpenClaw onay kapisinda kalici Calculator linki
# olusturabilir. Once allowFrom + DM kisitlarini ve dry-run akislarini dogrulayin.
WEB_SERVICE_ALLOW_PUBLISH=0

# TLS'siz (http) denemede cerezin `Secure` bayragini kaldirir. SUNUCUDA
# KULLANMAYIN — TLS arkasinda calistirin.
WEB_INSECURE_COOKIE=

# --- YAYINLAMA ---
# Sistemin asil isi: onaydan sonra teklifi VMind'a kaydedip
#   calculator.portvmind.com/my-estimate/{id}
# linkini uretmek. Satisci bu linke tiklayinca hesap calculator'da DOLU ve
# DUZENLENEBILIR gelir — kalemleri tek tek elle girmenin yerine gecen sey bu.
#
# ⛔ ACIKKEN ONAYLANAN HER TEKLIF VMind'da KALICI kayit birakir.
#    Bilinen bir silme ucu YOK. Kapatmak icin bu satiri silin veya 0 yapin.
#
# Kapaliyken sistem teklifi yine hazirlar ama link uretmez.
# Varsayilan KAPALI. Canli sunucuda, kalici kayit davranisi bilerek kabul
# edildikten sonra 1 yapin.
WEB_ALLOW_PUBLISH=0

# --- harcama siniri (USD/gun). 0 = sinirsiz ---
# Sunucuda LLM anahtari duruyor; arayuze erisen herkes kredi harcayabilir.
# Fren burada.
LLM_DAILY_TOTAL_USD=5
LLM_DAILY_PER_USER_USD=1

# Harcama defterinin yeri. KALICI olmali: her yeniden baslatmada sifirlanirsa
# gunluk kota da sifirlanir. Docker'da volume'a baglanir.
BUDGET_FILE=./var/budget.json

# --- Faz 2: kalıcı akış, token, tool ve kota telemetrisi ---
# Canlıda bu adres genel internete açık değildir; iki VM arasındaki WireGuard
# hattındaki PostgreSQL'e gider. Yerelde boş bırakılırsa JSON defteri kullanılır.
VMIND_DATABASE_URL=
VMIND_TENANT_ID=00000000-0000-0000-0000-000000000001
VMIND_PROMPT_VERSION=phase2
# Yalniz PII icermeyen, birebir ayni yapisal LLM istekleri. Varsayilan 24 saat;
# model/prompt/sema degisirse anahtar da degisir. Tool cagirilari cache'lenmez.
VMIND_LLM_CACHE_TTL_SECONDS=86400

# --- Site -> CRM (OpenClaw VM) ---
# Iki deger birlikte verilmelidir. Canlida URL, host uzerindeki SSH tunelinin
# Docker kopru adresidir; musteri verisi genel internete acik bir porta gitmez.
VMIND_CRM_SITE_URL=
# Her iki VM'de ayni, en az 32 karakterlik ayri bir HMAC sirri. LLM/API anahtari
# degildir; tarayiciya, loga veya git'e yazilmaz.
VMIND_CRM_SITE_SECRET=
