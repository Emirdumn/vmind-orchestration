[Unit]
Description=VMind encrypted offsite PostgreSQL backup with restic
After=network-online.target vmind-runtime-postgres-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/vmind/offsite-backup.env
Environment=VMIND_BACKUP_DIR=/var/backups/vmind-runtime-postgres
Environment=VMIND_BACKUP_TAG=vmind-calculator
Environment=RESTIC_CACHE_DIR=/var/cache/vmind-restic
ExecStart=/usr/local/sbin/vmind-postgres-offsite-backup
Nice=15
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/backups/vmind-runtime-postgres
CacheDirectory=vmind-restic
CacheDirectoryMode=0700
